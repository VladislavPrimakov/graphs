{
  "name": "graphs",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "site",
    "pipelines",
    "shared"
  ],
  "scripts": {
    "dev": "bun --filter @graphs/site dev",
    "build": "bun run build:pipeline && bun run build:site",
    "build:pipeline": "bun --filter @graphs/pipelines --silent build",
    "build:site": "bun --filter @graphs/site build",
    "preview": "bun --filter @graphs/site preview",
    "generate:og": "bun --filter @graphs/site generate:og",
    "test:ci": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-ci.ps1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "knip": "^6.42.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}

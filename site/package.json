{
  "name": "@graphs/site",
  "private": true,
  "type": "module",
  "scripts": {
    "extract-cldr": "bun scripts/extract-cldr-units.ts",
    "dev": "bun run extract-cldr && react-router dev",
    "start": "react-router dev",
    "build": "bun run --silent extract-cldr && bun run --silent check:knip && bun run --silent check && bun run --silent type-check && react-router build",
    "preview": "serve -l 3001 dist/client",
    "check": "biome check --write src scripts",
    "check:knip": "knip --directory .. --workspace @graphs/site",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@graphs/types": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@react-router/node": "^7.18.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "echarts": "^6.1.0",
    "isbot": "^5.1.28",
    "maplibre-gl": "^6.12.0",
    "marked": "^18.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "string-hash": "^1.1.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/babel__core": "^7.20.5",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/string-hash": "^1.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cldr-units-full": "^48.2.0",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}

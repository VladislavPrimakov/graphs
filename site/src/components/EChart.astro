---
import { themeColors, CHART_BASE_THEME } from '../styles/tokens.js';

interface Props {
  option: Record<string, any>;
  height?: string;
  className?: string;
  chartId?: string;
}

const {
  option,
  height = '480px',
  className = '',
  chartId = 'echart-' + Math.random().toString(36).substring(2, 9),
} = Astro.props;

// Helper to merge axis defaults with theme
const mergeAxis = (axis: any, isYAxis = false) => {
  if (!axis) return axis;
  const defaultAxis = isYAxis ? CHART_BASE_THEME.yAxis : CHART_BASE_THEME.xAxis;
  if (Array.isArray(axis)) {
    return axis.map((a) => ({
      ...defaultAxis,
      ...a,
      axisLabel: { ...defaultAxis.axisLabel, ...(a.axisLabel || {}) },
      axisLine: { ...defaultAxis.axisLine, ...(a.axisLine || {}) },
      splitLine: { ...defaultAxis.splitLine, ...(a.splitLine || {}) },
      nameTextStyle: { ...defaultAxis.nameTextStyle, ...(a.nameTextStyle || {}) },
    }));
  }
  return {
    ...defaultAxis,
    ...axis,
    axisLabel: { ...defaultAxis.axisLabel, ...(axis.axisLabel || {}) },
    axisLine: { ...defaultAxis.axisLine, ...(axis.axisLine || {}) },
    splitLine: { ...defaultAxis.splitLine, ...(axis.splitLine || {}) },
    nameTextStyle: { ...defaultAxis.nameTextStyle, ...(axis.nameTextStyle || {}) },
  };
};

// Helper to merge dataZoom defaults
const mergeDataZoom = (dataZoom: any) => {
  if (!dataZoom) return dataZoom;
  if (Array.isArray(dataZoom)) {
    return dataZoom.map((dz) => {
      if (dz.type === 'slider') {
        return { ...CHART_BASE_THEME.dataZoom, ...dz };
      }
      return dz;
    });
  }
  return dataZoom.type === 'slider' ? { ...CHART_BASE_THEME.dataZoom, ...dataZoom } : dataZoom;
};

// Default dark theme styling merges
const enhancedOption = {
  backgroundColor: 'transparent',
  ...option,
  textStyle: {
    fontFamily: 'Inter, system-ui, -apple-system, sans-serif',
    ...(option.textStyle || {}),
  },
  title: option.title
    ? {
        ...CHART_BASE_THEME.title,
        ...option.title,
        textStyle: { ...CHART_BASE_THEME.title.textStyle, ...(option.title.textStyle || {}) },
        subtextStyle: { ...CHART_BASE_THEME.title.subtextStyle, ...(option.title.subtextStyle || {}) },
      }
    : undefined,
  legend: option.legend
    ? {
        ...CHART_BASE_THEME.legend,
        ...option.legend,
        textStyle: { ...CHART_BASE_THEME.legend.textStyle, ...(option.legend.textStyle || {}) },
      }
    : undefined,
  grid: {
    ...CHART_BASE_THEME.grid,
    ...(option.grid || {}),
  },
  xAxis: mergeAxis(option.xAxis, false),
  yAxis: mergeAxis(option.yAxis, true),
  dataZoom: mergeDataZoom(option.dataZoom),
  tooltip: {
    ...CHART_BASE_THEME.tooltip,
    ...(option.tooltip || {}),
    textStyle: {
      ...CHART_BASE_THEME.tooltip.textStyle,
      ...(option.tooltip?.textStyle || {}),
    },
  },
  toolbox: {
    show: true,
    right: '2%',
    top: '2%',
    iconStyle: {
      borderColor: themeColors.text.muted,
    },
    emphasis: {
      iconStyle: {
        borderColor: themeColors.accent.primary,
      },
    },
    feature: {
      dataZoom: { yAxisIndex: 'none', title: { zoom: 'Zoom', back: 'Reset' } },
      restore: { title: 'Restore' },
      saveAsImage: { pixelRatio: 2, title: 'Export PNG', type: 'png', backgroundColor: themeColors.surface.card },
      ...(option.toolbox?.feature || {}),
    },
    ...(option.toolbox || {}),
  },
};

const serializedOption = JSON.stringify(enhancedOption);
---

<div class={`relative w-full ${className}`}>
  <div
    id={chartId}
    class="echart-container w-full"
    style={`height: ${height}; min-height: 320px;`}
    data-chart-option={serializedOption}
  ></div>
</div>

<script>
  import * as echarts from 'echarts/core';
  import { BarChart, LineChart } from 'echarts/charts';
  import {
    TitleComponent,
    TooltipComponent,
    GridComponent,
    LegendComponent,
    ToolboxComponent,
    DataZoomComponent,
    MarkPointComponent,
    MarkLineComponent,
  } from 'echarts/components';
  import { LabelLayout } from 'echarts/features';
  import { CanvasRenderer } from 'echarts/renderers';
  import { resolveFormatters } from '../charts/formatters';

  echarts.use([
    BarChart,
    LineChart,
    TitleComponent,
    TooltipComponent,
    GridComponent,
    LegendComponent,
    ToolboxComponent,
    DataZoomComponent,
    MarkPointComponent,
    MarkLineComponent,
    LabelLayout,
    CanvasRenderer,
  ]);

  function initCharts() {
    const containers = document.querySelectorAll<HTMLElement>('.echart-container[data-chart-option]');
    containers.forEach((container) => {
      const existing = echarts.getInstanceByDom(container);
      if (existing) {
        existing.resize();
        return;
      }

      try {
        const optionStr = container.getAttribute('data-chart-option');
        if (!optionStr) return;
        const rawOption = JSON.parse(optionStr);
        const option = resolveFormatters(rawOption);

        const chart = echarts.init(container, 'dark', {
          renderer: 'canvas',
        });
        chart.setOption(option);

        let resizeTimer: number;
        const ro = new ResizeObserver(() => {
          cancelAnimationFrame(resizeTimer);
          resizeTimer = requestAnimationFrame(() => {
            chart.resize();
          });
        });
        ro.observe(container);
      } catch (err) {
        console.error('Error initializing EChart:', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharts);
  } else {
    initCharts();
  }

  document.addEventListener('astro:page-load', initCharts);
</script>

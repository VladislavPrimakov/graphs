---
interface Props {
  label: string;
  value: string | number;
  subtext?: string;
  valueColor?: string;
  subtextColor?: string;
  className?: string;
}

const {
  label,
  value,
  subtext,
  valueColor = 'text-white',
  subtextColor = 'text-slate-500',
  className = '',
} = Astro.props;
---

<div class={`bg-slate-900/60 border border-slate-800/80 rounded-xl p-4 ${className}`}>
  <div class="text-xs text-slate-400">{label}</div>
  <div class={`text-2xl sm:text-3xl font-bold mt-1 ${valueColor}`}>
    {typeof value === 'number' ? value.toLocaleString() : value}
  </div>
  {subtext && (
    <div class={`text-xs mt-1 ${subtextColor}`} set:html={subtext} />
  )}
</div>

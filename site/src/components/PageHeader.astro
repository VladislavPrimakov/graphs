---
import TagBadge from './TagBadge.astro';

interface Source {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  tags?: string[];
  sources?: Source[];
  lastUpdated?: string;
}

const { title, description, tags = [], sources = [], lastUpdated } = Astro.props;
---

<div class="border-b border-slate-800 pb-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      {title}
    </h1>
    {lastUpdated && (
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs font-medium text-slate-400 shrink-0">
        <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Updated: <span class="text-slate-200 font-semibold">{lastUpdated}</span></span>
      </div>
    )}
  </div>
  {description && (
    <p class="mt-3 text-base text-slate-400 leading-relaxed" set:html={description} />
  )}

  {(tags.length > 0 || sources.length > 0) && (
    <div class="mt-5 space-y-2.5">
      {tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <span class="w-16 shrink-0 text-slate-400 font-semibold uppercase tracking-wider">Tags:</span>
          <div class="flex flex-wrap items-center gap-2">
            {tags.map((tag) => (
              <TagBadge tag={tag} />
            ))}
          </div>
        </div>
      )}

      {sources.length > 0 && (
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <span class="w-16 shrink-0 text-slate-400 font-semibold uppercase tracking-wider">Sources:</span>
          <div class="flex flex-wrap items-center gap-2">
            {sources.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-sky-400 hover:text-sky-300 hover:border-slate-700 transition-colors"
              >
                <span>{s.name}</span>
                <svg class="w-3 h-3 ml-1 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</div>

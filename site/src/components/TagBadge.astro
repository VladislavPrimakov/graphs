---
import { getTagClasses } from '../styles/tokens.js';

interface Props {
  tag: string;
  interactive?: boolean;
  title?: string;
  class?: string;
}

const {
  tag,
  interactive = false,
  title,
  class: className = '',
} = Astro.props;

const style = getTagClasses(tag);
const tooltip = title || (interactive ? `Filter by ${tag}` : undefined);
const baseClasses = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border transition-all duration-150';
---

{interactive ? (
  <button
    type="button"
    data-tag-click={tag}
    title={tooltip}
    class={`card-tag-pill ${baseClasses} hover:scale-105 cursor-pointer ${style} ${className}`}
  >
    {tag}
  </button>
) : (
  <span
    title={tooltip}
    class={`${baseClasses} ${style} ${className}`}
  >
    {tag}
  </span>
)}

---
interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { title, description, className = '' } = Astro.props;
---

<div class={`bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 sm:p-6 shadow-xl backdrop-blur-sm ${className}`}>
  {title && (
    <div class="mb-4">
      <h2 class="text-xl font-bold text-slate-100">{title}</h2>
      {description && (
        <p class="text-xs text-slate-400 mt-1" set:html={description} />
      )}
    </div>
  )}
  <slot />
</div>

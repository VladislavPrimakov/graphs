---
import Layout from '../layouts/Layout.astro';
import EChart from '../components/EChart.astro';
import PageHeader from '../components/PageHeader.astro';
import ChartCard from '../components/ChartCard.astro';
import KpiCard from '../components/KpiCard.astro';
import data from '../data/war-rf-ua-losses.json';
import { getProject } from '../data/projects';
import { WAR_LOSSES_THEME } from '../styles/charts';
import { themeColors } from '../styles/tokens.js';

const project = getProject('war-rf-ua-losses');
const { summary, periods, overall_timeline, by_category, category_chart } = data;

const categoryChartOption = {
  title: {
    text: 'Visually Confirmed Heavy Equipment Losses by Category',
    subtext: 'Comparative photo- and video-verified equipment losses (RF vs Ukraine) across 8 heavy combat vehicle categories.',
  },
  tooltip: {
    trigger: 'axis',
    axisPointer: { type: 'shadow' },
    formatter: 'warCategoryLossesTooltip',
  },
  legend: {},
  grid: {
    top: 100,
    left: '3%',
    right: '4%',
    bottom: '8%',
    containLabel: true,
  },
  xAxis: {
    type: 'category',
    data: category_chart.labels,
    axisLabel: { rotate: 15 },
  },
  yAxis: {
    type: 'value',
    name: 'Units',
  },
  series: [
    {
      name: 'Russian Federation (RF)',
      type: 'bar',
      data: category_chart.rf_series,
      itemStyle: { color: WAR_LOSSES_THEME.sides.rf, borderRadius: [4, 4, 0, 0] },
      label: {
        show: true,
        position: 'top',
        color: themeColors.status.dangerLight,
        fontSize: 10,
        fontWeight: 'bold',
        textBorderColor: themeColors.surface.card,
        textBorderWidth: 2,
      },
    },
    {
      name: 'Ukraine (UA)',
      type: 'bar',
      data: category_chart.ua_series,
      itemStyle: { color: WAR_LOSSES_THEME.sides.ua, borderRadius: [4, 4, 0, 0] },
      label: {
        show: true,
        position: 'top',
        color: themeColors.accent.blueLight,
        fontSize: 10,
        fontWeight: 'bold',
        textBorderColor: themeColors.surface.card,
        textBorderWidth: 2,
      },
    },
  ],
};

// Chart 2: Monthly Timeline of Overall Losses
const timelineChartOption = {
  title: {
    text: 'Monthly Timeline of Confirmed Equipment Losses (All Categories)',
    subtext: 'Monthly timeline of visually confirmed equipment losses documented across all categories from February 2022 to 2026.',
  },
  tooltip: {
    trigger: 'axis',
    axisPointer: { type: 'cross' },
    formatter: 'warTimelineLossesTooltip',
  },
  legend: {},
  grid: {
    bottom: '12%',
  },
  dataZoom: [
    {
      type: 'slider',
      show: true,
      xAxisIndex: [0],
      start: 0,
      end: 100,
      bottom: '2%',
    },
    { type: 'inside', xAxisIndex: [0] },
  ],
  xAxis: {
    type: 'category',
    data: periods,
    axisLabel: { rotate: 45 },
  },
  yAxis: {
    type: 'value',
    name: 'Units',
  },
  series: [
    {
      name: 'Russian Federation (RF)',
      type: 'line',
      data: overall_timeline.rf_series || overall_timeline.rf,
      smooth: true,
      lineStyle: { width: 3, color: WAR_LOSSES_THEME.sides.rf },
      itemStyle: { color: WAR_LOSSES_THEME.sides.rf },
      symbol: 'circle',
      symbolSize: 6,
    },
    {
      name: 'Ukraine (UA)',
      type: 'line',
      data: overall_timeline.ua_series || overall_timeline.ua,
      smooth: true,
      lineStyle: { width: 3, color: WAR_LOSSES_THEME.sides.ua },
      itemStyle: { color: WAR_LOSSES_THEME.sides.ua },
      symbol: 'circle',
      symbolSize: 6,
    },
  ],
};
---

<Layout title={project.title} description={project.description}>
  <div class="space-y-10">
    <PageHeader
      title={project.title}
      description={project.description}
      tags={project.tags}
      sources={project.sources}
      lastUpdated={data.last_updated}
    />

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <KpiCard
        label="Russian Federation Losses"
        value={summary.total_rf}
        valueColor="text-red-500"
        subtext="Verified equipment units"
      />
      <KpiCard
        label="Ukraine Losses"
        value={summary.total_ua}
        valueColor="text-blue-400"
        subtext="Verified equipment units"
      />
      <KpiCard
        label="RF / UA Overall Ratio"
        value={`${summary.overall_ratio} : 1`}
        valueColor="text-amber-400"
        subtext="Total relative loss ratio"
      />
      <KpiCard
        label="Total Database Records"
        value={summary.total_records}
        valueColor="text-slate-100"
        subtext={`Includes ${summary.total_unknown} unclassified`}
      />
    </div>

    <!-- Chart 1: Losses by Category -->
    <ChartCard>
      <EChart option={categoryChartOption} height="480px" chartId="chart-losses-category" />
    </ChartCard>

    <!-- Chart 2: Timeline of Losses -->
    <ChartCard>
      <EChart option={timelineChartOption} height="480px" chartId="chart-losses-timeline" />
    </ChartCard>

    <!-- Equipment Models Breakdown (Lost Systems by Category) -->
    <ChartCard
      title="Equipment System Breakdown by Category"
      description="Visually verified equipment models lost for each side across all military equipment categories (showing top 5 by default)."
    >
      <div class="flex justify-end mb-4 -mt-2">
        <button
          type="button"
          id="toggle-all-models-btn"
          data-all-expanded="false"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900/90 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-xs font-semibold text-slate-300 hover:text-sky-300 transition-colors shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
          <span id="toggle-all-models-text">Expand all categories</span>
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-start">
        {summary.categories.map((cat: any) => {
          const catData = by_category[cat.id];
          const allRf = catData?.models?.rf || [];
          const allUa = catData?.models?.ua || [];
          const topRf = allRf.slice(0, 5);
          const topUa = allUa.slice(0, 5);
          const restRf = allRf.slice(5);
          const restUa = allUa.slice(5);
          const hasMore = restRf.length > 0 || restUa.length > 0;
          const totalModels = Math.max(allRf.length, allUa.length);

          return (
            <div class="model-card bg-slate-950/70 border border-slate-800 rounded-xl p-4 flex flex-col justify-between transition-all duration-200 hover:border-slate-700/80">
              <div>
                <div class="flex items-center justify-between border-b border-slate-800/80 pb-2 mb-3">
                  <span class="font-bold text-sm text-slate-100">{cat.label_en}</span>
                  <span class="text-xs px-2 py-0.5 rounded bg-slate-800 text-amber-400 font-semibold">
                    {cat.ratio ? `${cat.ratio}:1` : '—'}
                  </span>
                </div>

                <div class="space-y-3 text-xs">
                  <!-- RF -->
                  <div>
                    <div class="flex justify-between font-semibold text-rose-400 mb-1">
                      <span>RF: {cat.rf.toLocaleString()}</span>
                      <span class="text-[11px] font-normal text-slate-500">{allRf.length} models</span>
                    </div>
                    <div class="space-y-0.5 text-slate-400 pl-1 border-l-2 border-rose-500/40">
                      {topRf.map((m: any) => (
                        <div class="flex justify-between">
                          <span class="truncate pr-2">{m.name}</span>
                          <span class="font-mono text-slate-300">{m.count}</span>
                        </div>
                      ))}
                      {restRf.length > 0 && (
                        <div class="model-extra-rf hidden space-y-0.5 pt-0.5">
                          {restRf.map((m: any) => (
                            <div class="flex justify-between">
                              <span class="truncate pr-2">{m.name}</span>
                              <span class="font-mono text-slate-300">{m.count}</span>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>

                  <!-- UA -->
                  <div>
                    <div class="flex justify-between font-semibold text-sky-400 mb-1">
                      <span>UA: {cat.ua.toLocaleString()}</span>
                      <span class="text-[11px] font-normal text-slate-500">{allUa.length} models</span>
                    </div>
                    <div class="space-y-0.5 text-slate-400 pl-1 border-l-2 border-sky-500/40">
                      {topUa.map((m: any) => (
                        <div class="flex justify-between">
                          <span class="truncate pr-2">{m.name}</span>
                          <span class="font-mono text-slate-300">{m.count}</span>
                        </div>
                      ))}
                      {restUa.length > 0 && (
                        <div class="model-extra-ua hidden space-y-0.5 pt-0.5">
                          {restUa.map((m: any) => (
                            <div class="flex justify-between">
                              <span class="truncate pr-2">{m.name}</span>
                              <span class="font-mono text-slate-300">{m.count}</span>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              {hasMore && (
                <button
                  type="button"
                  data-expanded="false"
                  data-total={totalModels}
                  class="model-toggle-btn mt-3 w-full py-1.5 px-3 rounded-lg bg-slate-900/90 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-xs font-semibold text-slate-400 hover:text-sky-300 transition-colors flex items-center justify-center gap-1.5 group"
                >
                  <span class="btn-label">Expand all ({totalModels})</span>
                  <svg class="w-3.5 h-3.5 transform transition-transform duration-200 btn-chevron text-slate-500 group-hover:text-sky-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              )}
            </div>
          );
        })}
      </div>
    </ChartCard>
  </div>
</Layout>

<script>
  function setupModelToggles() {
    const cardButtons = document.querySelectorAll<HTMLButtonElement>('.model-toggle-btn');
    const globalToggleBtn = document.getElementById('toggle-all-models-btn');
    const globalToggleText = document.getElementById('toggle-all-models-text');

    function setCardExpanded(btn: HTMLButtonElement, expand: boolean) {
      const card = btn.closest('.model-card');
      if (!card) return;
      const extraRf = card.querySelector('.model-extra-rf');
      const extraUa = card.querySelector('.model-extra-ua');
      const label = btn.querySelector('.btn-label');
      const chevron = btn.querySelector('.btn-chevron');
      const total = btn.getAttribute('data-total') || '';

      if (expand) {
        extraRf?.classList.remove('hidden');
        extraUa?.classList.remove('hidden');
        btn.setAttribute('data-expanded', 'true');
        if (label) label.textContent = 'Collapse';
        chevron?.classList.add('rotate-180');
      } else {
        extraRf?.classList.add('hidden');
        extraUa?.classList.add('hidden');
        btn.setAttribute('data-expanded', 'false');
        if (label) label.textContent = `Expand all (${total})`;
        chevron?.classList.remove('rotate-180');
      }
    }

    cardButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('data-expanded') === 'true';
        setCardExpanded(btn, !isExpanded);
        updateGlobalState();
      });
    });

    function updateGlobalState() {
      if (!globalToggleBtn || !globalToggleText) return;
      const anyCollapsed = Array.from(cardButtons).some(
        (b) => b.getAttribute('data-expanded') !== 'true'
      );
      if (anyCollapsed) {
        globalToggleText.textContent = 'Expand all categories';
        globalToggleBtn.setAttribute('data-all-expanded', 'false');
      } else {
        globalToggleText.textContent = 'Collapse all categories';
        globalToggleBtn.setAttribute('data-all-expanded', 'true');
      }
    }

    if (globalToggleBtn) {
      globalToggleBtn.addEventListener('click', () => {
        const allExpanded = globalToggleBtn.getAttribute('data-all-expanded') === 'true';
        cardButtons.forEach((btn) => setCardExpanded(btn, !allExpanded));
        updateGlobalState();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupModelToggles);
  } else {
    setupModelToggles();
  }
  document.addEventListener('astro:page-load', setupModelToggles);
</script>

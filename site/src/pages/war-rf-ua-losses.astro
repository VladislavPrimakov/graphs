---
import WarLossesCategoryGraph from '../components/graphs/WarLossesCategoryGraph';
import WarLossesEquipmentBreakdown from '../components/graphs/WarLossesEquipmentBreakdown';
import WarLossesSummaryKpi from '../components/graphs/WarLossesSummaryKpi';
import WarLossesTimelineGraph from '../components/graphs/WarLossesTimelineGraph';
import data from '../data/war-rf-ua-losses.json';
import Layout from '../layouts/Layout.astro';

const { summary, periods, overall_timeline, by_category, category_chart } = data;
---

<Layout project="war-rf-ua-losses">
  <WarLossesSummaryKpi client:load summary={summary} />
  <WarLossesCategoryGraph client:load category_chart={category_chart} />
  <WarLossesTimelineGraph client:load periods={periods} overall_timeline={overall_timeline} />
  <WarLossesEquipmentBreakdown client:load categories={summary.categories} by_category={by_category} />
</Layout>

---
import WorldEconomicLineGraph from '../components/graphs/WorldEconomicLineGraph';
import data from '../data/world-economic.json';
import Layout from '../layouts/Layout.astro';

const { years, entities, charts } = data;
---

<Layout project="world-economic">
  <WorldEconomicLineGraph
    client:load
    chartId="gdp-ppp"
    title="GDP at Purchasing Power Parity (PPP)"
    subtitle="Constant 2021 international dollars (trillions)."
    years={years}
    entities={entities}
    data={charts.gdp_ppp}
  />
  <WorldEconomicLineGraph
    client:load
    chartId="gdp-per-capita-ppp"
    title="GDP per Capita at Purchasing Power Parity (PPP)"
    subtitle="Constant 2021 international dollars per person."
    years={years}
    entities={entities}
    data={charts.gdp_per_capita_ppp}
  />
  <WorldEconomicLineGraph
    client:load
    chartId="machinery-turnover"
    title="Machinery & Equipment Trade Turnover"
    subtitle="Exports and imports (HS 84-85) in current USD billions."
    years={years}
    entities={entities}
    data={charts.machinery_turnover}
  />
  <WorldEconomicLineGraph
    client:load
    chartId="electricity-generation"
    title="Gross Electricity Generation"
    subtitle="Annual gross generation across all power sources (TWh)."
    years={years}
    entities={entities}
    data={charts.electricity_generation}
  />
  <WorldEconomicLineGraph
    client:load
    chartId="manufacturing-value-added"
    title="Manufacturing Value Added Output"
    subtitle="Constant 2015 USD (billions)."
    years={years}
    entities={entities}
    data={charts.manufacturing_value_added}
  />
  <WorldEconomicLineGraph
    client:load
    chartId="clean-power"
    title="Solar & Wind Electricity Generation"
    subtitle="Annual combined generation from solar PV and wind turbines (TWh)."
    years={years}
    entities={entities}
    data={charts.clean_power}
  />
  <WorldEconomicLineGraph
    client:load
    chartId="electricity-per-capita"
    title="Electricity Consumption per Capita"
    subtitle="Annual electricity consumption per person (kWh)."
    years={years}
    entities={entities}
    data={charts.electricity_per_capita}
  />
</Layout>

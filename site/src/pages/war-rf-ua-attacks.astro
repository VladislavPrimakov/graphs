---
import WarAttacksMissilesGraph from '../components/graphs/WarAttacksMissilesGraph';
import WarAttacksUavGraph from '../components/graphs/WarAttacksUavGraph';
import data from '../data/war-rf-ua-attacks.json';
import Layout from '../layouts/Layout.astro';

const { rf_attacks, ua_attacks, unified_timeline } = data;
---

<Layout project="war-rf-ua-attacks">
  <WarAttacksUavGraph client:load rf={rf_attacks.summary} ua={ua_attacks.summary} timeline={unified_timeline} />
  <WarAttacksMissilesGraph client:load rf={rf_attacks.summary} ua={ua_attacks.summary} timeline={unified_timeline} />
</Layout>

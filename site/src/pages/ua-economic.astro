---
import UaEconomicBudgetDebtGraph from '../components/graphs/UaEconomicBudgetDebtGraph';
import UaEconomicTradeStructureGraph from '../components/graphs/UaEconomicTradeStructureGraph';
import data from '../data/ua-economic.json';
import Layout from '../layouts/Layout.astro';

const { budget_debt, trade } = data;
---

<Layout project="ua-economic">
  <UaEconomicBudgetDebtGraph client:load budget_debt={budget_debt} />
  <UaEconomicTradeStructureGraph client:load trade={trade} />
</Layout>

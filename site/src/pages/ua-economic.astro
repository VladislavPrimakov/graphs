---
import Layout from '../layouts/Layout.astro';
import EChart from '../components/EChart.astro';
import PageHeader from '../components/PageHeader.astro';
import ChartCard from '../components/ChartCard.astro';
import data from '../data/ua-economic.json';
import { getProject } from '../data/projects';
import { UA_ECONOMIC_THEME } from '../styles/charts';
import { themeColors } from '../styles/tokens.js';

const project = getProject('ua-economic');
const { budget_debt, trade } = data;

// Formatting helpers
const formatSegment = (val: number, pct?: number | null) => {
  if (val <= UA_ECONOMIC_THEME.thresholds.minSegmentValue) return '';
  return pct !== undefined && pct !== null ? `${val.toFixed(1)}\n(${pct}%)` : `${val.toFixed(1)}`;
};

const formatWithGdp = (val: number, gdpPct?: number | null) => {
  return gdpPct ? `${val.toFixed(1)}\n(${gdpPct}% GDP)` : `${val.toFixed(1)}`;
};

// Construct multiline rich-text labels for X-axis: Year, Weighted Exchange Rate, Net Fiscal Balance
const xAxisData = budget_debt.years.map((_: number, idx: number) => {
  const yLabel = budget_debt.year_labels[idx];
  const rate = budget_debt.rates[idx];
  const bal = budget_debt.balances[idx];
  const balSign = `${bal > 0 ? '+' : ''}${bal.toFixed(1)}`;
  const balTag = bal < 0 ? 'balNeg' : 'balPos';
  return `{year|${yLabel}}\n{rate|(FX: ${rate.toFixed(2)})}\n{${balTag}|Balance: ${balSign}}`;
});

// Segment series generator for budget stacks
function createBudgetSegment({
  name,
  stack,
  values,
  percentages,
  color,
  borderRadius,
}: {
  name: string;
  stack?: string;
  values: number[];
  percentages?: (number | null)[];
  color: string;
  borderRadius?: [number, number, number, number];
}) {
  return {
    name,
    type: 'bar',
    ...(stack ? { stack } : {}),
    data: values.map((val, idx) => {
      const lbl = percentages ? formatSegment(val, percentages[idx]) : '';
      return {
        value: val,
        label: {
          show: Boolean(lbl),
          position: 'inside',
          color: UA_ECONOMIC_THEME.budget.insideBarText,
          fontSize: 10,
          fontWeight: 'bold',
          lineHeight: 12,
          textBorderColor: themeColors.surface.card,
          textBorderWidth: 2,
          formatter: lbl,
        },
      };
    }),
    itemStyle: {
      color,
      ...(borderRadius ? { borderRadius } : {}),
    },
  };
}

// Stack total annotation generator
function createStackTotalSeries(stack: string, totals: number[], gdpPcts: (number | null)[], color: string) {
  return {
    name: `${stack} Total`,
    type: 'bar',
    stack,
    silent: true,
    data: totals.map((tot, idx) => ({
      value: 0,
      label: {
        show: tot > 0,
        position: 'top',
        distance: 5,
        color,
        fontSize: 10,
        fontWeight: 'bold',
        lineHeight: 13,
        textBorderColor: themeColors.surface.card,
        textBorderWidth: 2,
        formatter: formatWithGdp(tot, gdpPcts[idx]),
      },
    })),
    tooltip: { show: false },
  };
}

// Chart 1: Budget, Debt & GDP
const budgetChartOption = {
  title: {
    text: 'Comparison of Ukraine State Budget, Gross External Debt and GDP (Billion USD)',
    subtext: 'Columns: 1) Expenditures (Defense + Other), 2) Revenues & Financing, 3) External Debt, 4) Nominal GDP.',
  },
  tooltip: {
    show: false,
  },
  legend: {
    data: [
      'Expenditures: Defense',
      'Expenditures: Other',
      'Revenues: Domestic Taxes',
      'Revenues: External Grants',
      'Financing: External Loans',
      'Gross External Debt',
      'Nominal GDP (annual)',
    ],
  },
  grid: {
    top: 105,
    bottom: '12%',
  },
  xAxis: {
    type: 'category',
    data: xAxisData,
    axisLabel: {
      interval: 0,
      rich: {
        year: {
          fontSize: 13,
          fontWeight: 'bold',
          color: themeColors.text.primary,
          lineHeight: 18,
          align: 'center',
        },
        rate: {
          fontSize: 10,
          color: themeColors.text.muted,
          lineHeight: 15,
          align: 'center',
        },
        balNeg: {
          fontSize: 10,
          fontWeight: 'bold',
          color: themeColors.status.dangerMuted,
          lineHeight: 15,
          align: 'center',
        },
        balPos: {
          fontSize: 10,
          fontWeight: 'bold',
          color: themeColors.status.successLight,
          lineHeight: 15,
          align: 'center',
        },
      },
    },
  },
  yAxis: [
    {
      type: 'value',
      name: 'Billion USD ($)',
    },
  ],
  series: [
    // Column 1: Expenditures Stack
    createBudgetSegment({
      name: 'Expenditures: Defense',
      stack: 'Expenditures',
      values: budget_debt.defense,
      percentages: budget_debt.defense_pct,
      color: UA_ECONOMIC_THEME.budget.defense,
    }),
    createBudgetSegment({
      name: 'Expenditures: Other',
      stack: 'Expenditures',
      values: budget_debt.other_exp,
      percentages: budget_debt.other_exp_pct,
      color: UA_ECONOMIC_THEME.budget.otherExp,
      borderRadius: [4, 4, 0, 0],
    }),
    createStackTotalSeries('Expenditures', budget_debt.total_exp, budget_debt.exp_gdp_pct, UA_ECONOMIC_THEME.budget.totalExpLabel),

    // Column 2: Revenues Stack
    createBudgetSegment({
      name: 'Revenues: Domestic Taxes',
      stack: 'Revenues',
      values: budget_debt.domestic_rev,
      percentages: budget_debt.domestic_rev_pct,
      color: UA_ECONOMIC_THEME.budget.domesticRev,
    }),
    createBudgetSegment({
      name: 'Revenues: External Grants',
      stack: 'Revenues',
      values: budget_debt.grants,
      percentages: budget_debt.grants_pct,
      color: UA_ECONOMIC_THEME.budget.grants,
    }),
    createBudgetSegment({
      name: 'Financing: External Loans',
      stack: 'Revenues',
      values: budget_debt.loans,
      percentages: budget_debt.loans_pct,
      color: UA_ECONOMIC_THEME.budget.loans,
      borderRadius: [4, 4, 0, 0],
    }),
    createStackTotalSeries('Revenues', budget_debt.total_rev_fin, budget_debt.rev_gdp_pct, UA_ECONOMIC_THEME.budget.totalRevLabel),

    // Column 3: Gross External Debt
    {
      name: 'Gross External Debt',
      type: 'bar',
      data: budget_debt.debt.map((val: number, idx: number) => ({
        value: val,
        label: {
          show: true,
          position: 'top',
          distance: 5,
          color: UA_ECONOMIC_THEME.budget.debtLabel,
          fontSize: 10,
          fontWeight: 'bold',
          lineHeight: 13,
          textBorderColor: themeColors.surface.card,
          textBorderWidth: 2,
          formatter: formatWithGdp(val, budget_debt.debt_gdp_pct[idx]),
        },
      })),
      itemStyle: {
        color: UA_ECONOMIC_THEME.budget.debt,
        borderRadius: [4, 4, 0, 0],
      },
    },

    // Column 4: Nominal GDP (annual, rendered only when available)
    {
      name: 'Nominal GDP (annual)',
      type: 'bar',
      data: budget_debt.gdp.map((val: number | null) => ({
        value: val,
        label: {
          show: val !== null && val !== undefined,
          position: 'top',
          distance: 5,
          color: UA_ECONOMIC_THEME.budget.gdpLabel,
          fontSize: 10,
          fontWeight: 'bold',
          textBorderColor: themeColors.surface.card,
          textBorderWidth: 2,
          formatter: val ? `${val.toFixed(1)}` : '',
        },
      })),
      itemStyle: {
        color: UA_ECONOMIC_THEME.budget.gdp,
        borderRadius: [4, 4, 0, 0],
      },
    },
  ],
};

// Chart 2: Foreign Trade Structure (Exports vs Imports & Trade Balance)
const tradeYears = trade.years.map(String);

const exportsSeriesData = trade.total_exports.map((total: number, idx: number) => ({
  value: total,
  total,
  partners: trade.exports_breakdown?.[idx] || [],
}));

const importsSeriesData = trade.total_imports.map((total: number, idx: number) => ({
  value: total,
  total,
  partners: trade.imports_breakdown?.[idx] || [],
}));

const tradeChartOption = {
  title: {
    text: 'Ukraine Foreign Trade Structure & Trade Deficit (Billion USD)',
    subtext: 'Annual export and import volumes by geographic partner alongside the net foreign trade balance.',
  },
  tooltip: {
    trigger: 'axis',
    axisPointer: { type: 'shadow' },
    formatter: 'uaTradeTooltip',
  },
  legend: {
    data: ['Exports', 'Imports', 'Trade Balance (Exports - Imports)'],
  },
  grid: {
    bottom: '10%',
  },
  xAxis: {
    type: 'category',
    data: tradeYears,
    axisLabel: { fontSize: 13, fontWeight: 'bold' },
    axisLine: { onZero: false },
  },
  yAxis: {
    type: 'value',
    name: 'Billion USD ($)',
    min: -60,
    max: 100,
    interval: 20,
  },
  series: [
    {
      name: 'Exports',
      type: 'bar',
      data: exportsSeriesData,
      itemStyle: {
        color: UA_ECONOMIC_THEME.trade.exportTotal,
        borderRadius: [4, 4, 0, 0],
      },
      label: {
        show: true,
        position: 'top',
        distance: 6,
        color: UA_ECONOMIC_THEME.trade.exportTotal,
        fontSize: 13,
        fontWeight: 'bold',
        textBorderColor: themeColors.surface.card,
        textBorderWidth: 2,
        formatter: 'fixed1',
      },
    },
    {
      name: 'Imports',
      type: 'bar',
      data: importsSeriesData,
      itemStyle: {
        color: UA_ECONOMIC_THEME.trade.importTotal,
        borderRadius: [4, 4, 0, 0],
      },
      label: {
        show: true,
        position: 'top',
        distance: 6,
        color: UA_ECONOMIC_THEME.trade.importTotal,
        fontSize: 13,
        fontWeight: 'bold',
        textBorderColor: themeColors.surface.card,
        textBorderWidth: 2,
        formatter: 'fixed1',
      },
    },
    {
      name: 'Trade Balance (Exports - Imports)',
      type: 'line',
      data: trade.trade_balance,
      itemStyle: { color: UA_ECONOMIC_THEME.trade.balanceLine },
      lineStyle: { width: 3, type: 'dashed' },
      symbol: 'circle',
      symbolSize: 8,
      label: {
        show: true,
        position: 'bottom',
        distance: 8,
        color: UA_ECONOMIC_THEME.trade.balanceLabel,
        fontSize: 12,
        fontWeight: 'bold',
        textBorderColor: themeColors.surface.card,
        textBorderWidth: 2,
        formatter: 'signedFixed1',
      },
      markLine: {
        silent: true,
        symbol: 'none',
        data: [{ yAxis: 0 }],
        lineStyle: {
          color: themeColors.text.dim,
          width: 1.5,
          type: 'solid',
        },
        label: { show: false },
      },
    },
  ],
};
---

<Layout title={project.title} description={project.description}>
  <div class="space-y-10">
    <PageHeader
      title={project.title}
      description={project.description}
      tags={project.tags}
      sources={project.sources}
      lastUpdated={data.last_updated}
    />

    <!-- Chart 1: Budget Execution, Debt & GDP -->
    <ChartCard>
      <EChart option={budgetChartOption} height="540px" chartId="chart-ua-budget" />
    </ChartCard>

    <!-- Chart 2: Foreign Trade Structure & Deficit -->
    <ChartCard>
      <EChart option={tradeChartOption} height="500px" chartId="chart-ua-trade" />
    </ChartCard>
  </div>
</Layout>

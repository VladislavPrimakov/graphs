---
import CatalogGrid from '../components/CatalogGrid';
import { ALL_UNIQUE_TAGS, PROJECTS } from '../data/projects';
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = PROJECTS.map((p) => ({
  ...p,
  href: `${baseUrl}${p.path}`,
}));

const allUniqueTags = ALL_UNIQUE_TAGS;
---

<Layout title="Overview & Projects" description="Open data visualizations and analytics platform powered by Apache ECharts.">
  <div class="flex flex-col gap-8 sm:gap-10">
    <!-- Hero Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-surface-card via-surface-card/80 to-surface-base border border-border-subtle p-8 sm:p-10 shadow-xl">
      <div class="w-full">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-accent-glow text-accent-primary border border-accent-primary/20 mb-3">
          <span>Data Visualizations</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-content-primary tracking-tight">Interactive Graphs & Analytics</h1>
        <p class="mt-3 text-sm sm:text-base text-content-secondary leading-relaxed">
          Open-data visualization dashboards built with <strong>Astro</strong>, <strong>React</strong>, and <strong>Apache ECharts</strong>. Interactive zoom, rich tooltips, and responsive controls
          for deep exploration.
        </p>
      </div>
    </div>

    <!-- React Catalog Grid with Live Tag Filtering -->
    <CatalogGrid client:load projects={projects} allUniqueTags={allUniqueTags} />
  </div>
</Layout>

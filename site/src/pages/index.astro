---
import Layout from '../layouts/Layout.astro';
import TagBadge from '../components/TagBadge.astro';
import { PROJECTS, ALL_UNIQUE_TAGS } from '../data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = PROJECTS.map((p) => ({
  ...p,
  href: `${baseUrl}${p.path}`,
}));

const allUniqueTags = ALL_UNIQUE_TAGS;
---

<Layout title="Overview & Projects" description="Open data visualizations and analytics platform powered by Apache ECharts.">
  <div class="space-y-10">
    <!-- Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-slate-900 via-slate-900/80 to-slate-950 border border-slate-800 p-8 sm:p-10 shadow-xl">
      <div class="w-full">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20 mb-3">
          <span>Data Visualizations</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Interactive Graphs & Analytics
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
          Open-data visualization dashboards built with <strong>Astro</strong> and <strong>Apache ECharts</strong>. Interactive zoom, rich tooltips, and high-resolution PNG export for deep exploration.
        </p>
      </div>
    </div>

    <!-- Projects Section -->
    <div>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-white tracking-tight">Projects</h2>
      </div>

      <!-- Tag Filter Selector -->
      <div class="mb-8 p-3 rounded-2xl bg-slate-900/40 border border-slate-800/80">
        <div class="flex flex-wrap items-center gap-2" id="tag-filter-container">
          <span class="text-xs font-semibold text-slate-400 mr-1 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            Filter by tag:
          </span>
          <button
            type="button"
            data-filter="all"
            class="tag-filter-btn px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-150 bg-sky-500/20 text-sky-300 border-sky-500/40 shadow-sm shadow-sky-500/20"
          >
            All ({projects.length})
          </button>
          {allUniqueTags.map((tag) => (
            <button
              type="button"
              data-filter={tag}
              class={`tag-filter-btn px-2.5 py-1 rounded-full text-xs font-medium border transition-all duration-150 bg-slate-900/80 text-slate-400 border-slate-800 hover:text-slate-200 hover:border-slate-700`}
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

      <!-- Projects Grid -->
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((proj) => (
          <div
            data-project-card
            data-tags={JSON.stringify(proj.tags)}
            class="project-card group relative bg-slate-900/60 border border-slate-800/80 hover:border-slate-700 rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between shadow-lg"
          >
            <div>
              <!-- Top Tags list with individual colors and Last Updated -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="flex flex-wrap items-center gap-1.5">
                  {proj.tags.map((tag) => (
                    <TagBadge tag={tag} interactive />
                  ))}
                </div>
                {proj.lastUpdated && (
                  <span class="text-[11px] font-medium text-slate-500 shrink-0 flex items-center gap-1">
                    <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {proj.lastUpdated}
                  </span>
                )}
              </div>

              <!-- Title -->
              <a href={proj.href} class="block">
                <h3 class="text-xl font-bold text-white group-hover:text-sky-300 transition-colors">
                  {proj.title}
                </h3>
              </a>

              <!-- Description -->
              <p class="mt-2.5 text-sm text-slate-400 leading-relaxed">
                {proj.description}
              </p>
            </div>

            <!-- Footer: Sources & Link -->
            <div class="mt-6 pt-4 border-t border-slate-800/80 space-y-3 text-xs">
              <div class="flex flex-wrap items-center gap-1.5 text-slate-400">
                <span class="font-semibold text-slate-500">Sources:</span>
                {proj.sources.map((s, idx) => (
                  <span>
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-slate-400 hover:text-sky-300 underline underline-offset-2 transition-colors"
                    >
                      {s.name}
                    </a>
                    {idx < proj.sources.length - 1 && <span class="text-slate-600 ml-1">•</span>}
                  </span>
                ))}
              </div>

              <div class="flex justify-end pt-1">
                <a
                  href={proj.href}
                  class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-sky-600/10 text-sky-400 border border-sky-500/20 hover:bg-sky-500/20 transition-colors"
                >
                  Open Dashboard
                  <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- No match fallback -->
      <div id="no-projects-msg" class="hidden text-center py-12 bg-slate-900/40 border border-slate-800/80 rounded-2xl">
        <p class="text-slate-400 text-sm">No projects found matching the selected tag.</p>
        <button
          type="button"
          id="reset-filter-btn"
          class="mt-3 inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-sky-600/20 text-sky-400 border border-sky-500/30 hover:bg-sky-500/30 transition-colors"
        >
          Reset Filter
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupTagFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
    const noMatchMsg = document.getElementById('no-projects-msg');
    const resetBtn = document.getElementById('reset-filter-btn');
    const cardTagPills = document.querySelectorAll<HTMLButtonElement>('.card-tag-pill');

    const selectedTags = new Set<string>();

    function updateView() {
      const isAllActive = selectedTags.size === 0;
      let visibleCount = 0;

      // Update button styling
      filterButtons.forEach((btn) => {
        const tag = btn.getAttribute('data-filter');
        if (tag === 'all') {
          if (isAllActive) {
            btn.className = 'tag-filter-btn px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-150 bg-sky-500/20 text-sky-300 border-sky-500/40 shadow-sm shadow-sky-500/20';
          } else {
            btn.className = 'tag-filter-btn px-2.5 py-1 rounded-full text-xs font-medium border transition-all duration-150 bg-slate-900/80 text-slate-400 border-slate-800 hover:text-slate-200 hover:border-slate-700';
          }
        } else if (tag) {
          if (selectedTags.has(tag)) {
            btn.className = 'tag-filter-btn px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-150 bg-sky-500/25 text-sky-200 border-sky-400/60 shadow-md shadow-sky-500/30 scale-105';
          } else {
            btn.className = 'tag-filter-btn px-2.5 py-1 rounded-full text-xs font-medium border transition-all duration-150 bg-slate-900/80 text-slate-400 border-slate-800 hover:text-slate-200 hover:border-slate-700';
          }
        }
      });

      // Highlight matching tag pills inside cards
      cardTagPills.forEach((pill) => {
        const tag = pill.getAttribute('data-tag-click');
        if (tag && selectedTags.has(tag)) {
          pill.classList.add('ring-2', 'ring-sky-400', 'ring-offset-1', 'ring-offset-slate-950');
        } else {
          pill.classList.remove('ring-2', 'ring-sky-400', 'ring-offset-1', 'ring-offset-slate-950');
        }
      });

      // Filter cards: at least one tag matches (OR condition)
      cards.forEach((card) => {
        try {
          const tagsStr = card.getAttribute('data-tags') || '[]';
          const tags: string[] = JSON.parse(tagsStr);
          const isMatch = isAllActive || tags.some((t) => selectedTags.has(t));

          if (isMatch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        } catch (e) {
          card.classList.remove('hidden');
          visibleCount++;
        }
      });

      if (noMatchMsg) {
        if (visibleCount === 0) {
          noMatchMsg.classList.remove('hidden');
        } else {
          noMatchMsg.classList.add('hidden');
        }
      }
    }

    function toggleTag(tag: string) {
      if (tag === 'all') {
        selectedTags.clear();
      } else {
        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
        } else {
          selectedTags.add(tag);
        }
      }
      updateView();
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-filter') || 'all';
        toggleTag(tag);
      });
    });

    cardTagPills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tag = pill.getAttribute('data-tag-click');
        if (tag) toggleTag(tag);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        selectedTags.clear();
        updateView();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTagFilter);
  } else {
    setupTagFilter();
  }
  document.addEventListener('astro:page-load', setupTagFilter);
</script>

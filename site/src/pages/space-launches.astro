---
import SpaceLaunchesCostGraph from '../components/graphs/SpaceLaunchesCostGraph';
import SpaceLaunchesPayloadCapacityGraph from '../components/graphs/SpaceLaunchesPayloadCapacityGraph';
import data from '../data/space-launches.json';
import Layout from '../layouts/Layout.astro';

const { regions, payload_capacity, decade_costs } = data;
---

<Layout project="space-launches">
  <SpaceLaunchesPayloadCapacityGraph client:load regions={regions} payload_capacity={payload_capacity} />
  <SpaceLaunchesCostGraph client:load regions={regions} decade_costs={decade_costs} />
</Layout>

{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client", "bun"],
    "allowJs": false,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@graphs/shared/*": ["../shared/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "tests", "knip.ts", "react-router.config.ts", "vite.config.ts", ".react-router/types/**/*", "public/data/metadata.json"]
}

{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"],
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@graphs/types/*": ["../types/*"],
      "@/*": ["./src/*"],
      "@data/*": ["./public/data/*"]
    }
  },
  "include": ["src", "../types", "react-router.config.ts", "vite.config.ts", ".react-router/types/**/*"]
}

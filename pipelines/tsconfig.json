{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "paths": {
      "@/types/*": ["../types/*"],
      "@/types": ["../types/index"],
      "echarts": ["../site/node_modules/echarts"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo"
  },
  "include": ["src/**/*", "../types/**/*"]
}

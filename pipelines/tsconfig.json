{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo",
    "paths": {
      "@graphs/types/*": ["../types/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "../types/**/*"]
}

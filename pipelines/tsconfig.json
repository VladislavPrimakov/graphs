{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "paths": {
      "@/*": ["./src/*"],
      "@graphs/types": ["../types/index"],
      "@graphs/types/*": ["../types/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo"
  },
  "include": ["src/**/*", "../types/**/*"]
}

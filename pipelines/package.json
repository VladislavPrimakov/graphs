{
  "name": "@graphs/pipelines",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run --silent check:knip && bun run --silent check && bun run --silent type-check && bun src/run-all.ts",
    "check": "biome check --write src",
    "check:knip": "knip --directory .. --workspace @graphs/pipelines",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "ai-tokens": "bun src/ai-tokens/index.ts",
    "space-launches": "bun src/space-launches/index.ts",
    "world": "bun src/world/index.ts",
    "ukraine": "bun src/ukraine/index.ts",
    "war-losses": "bun src/war-rf-ua-losses/index.ts",
    "war-attacks": "bun src/war-rf-ua-attacks/index.ts"
  },
  "dependencies": {
    "@graphs/types": "workspace:*",
    "cheerio": "^1.1.2",
    "consola": "^3.4.2",
    "fast-xml-parser": "^5.4.1",
    "i18n-iso-countries": "^7.14.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}

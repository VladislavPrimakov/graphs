{
  "name": "@graphs/pipelines",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run --silent knip && bun run --silent check && bun run --silent type-check && bun src/run-all.ts",
    "check": "biome check --write",
    "knip": "knip --directory .. --workspace @graphs/pipelines",
    "type-check": "tsc --noEmit",
    "test:space-launches": "bun test src/space-launches/launches.test.ts",
    "test:war-rf-ua": "bun test src/war-rf-ua/parse-attacks-ua.test.ts",
    "test:country": "bun test src/country/cache.test.ts src/country/regions.test.ts",
    "test:world": "bun test src/world/regions.test.ts",
    "generate:countries": "bun src/country/generate-countries.ts",
    "run:ai-tokens": "bun src/ai-tokens/index.ts",
    "run:space-launches": "bun src/space-launches/index.ts",
    "run:world": "bun src/world/index.ts",
    "run:ukraine": "bun src/ukraine/index.ts",
    "run:country": "bun src/country/index.ts",
    "run:war-rf-ua": "bun src/war-rf-ua/index.ts"
  },
  "dependencies": {
    "@graphs/shared": "workspace:*",
    "cheerio": "^1.1.2",
    "consola": "^3.4.2",
    "fast-xml-parser": "^5.4.1",
    "i18n-iso-countries": "^7.14.0",
    "polygon-clipping": "^0.15.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
